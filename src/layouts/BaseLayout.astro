---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const { title, description = profile.site.description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
    <!-- Umami Analytics - Replace YOUR_UMAMI_ID with your actual website ID -->
    <!-- <script defer data-website-id="YOUR_UMAMI_ID" src="https://analytics.umami.is/script.js"></script> -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body class={profile.background.image ? 'has-bg' : ''}>
    <style is:inline>body{visibility:hidden}</style>
    <script is:inline>(function(){var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t);document.body.style.visibility='visible'})()</script>
    {profile.background.image && (
      <div class="site-bg" style={`--bg-scale: ${profile.background.scale};`}>
        <img
          src={profile.background.image}
          alt=""
          style={`opacity: ${profile.background.opacity}; filter: blur(${profile.background.blur});`}
          loading="eager"
        />
      </div>
    )}
    <div class="noise-overlay"></div>
    <div class="cursor-glow" id="cursor-glow"></div>
    <slot />
    <footer style="text-align:center;padding:20px;font-size:11px;color:var(--text-3);border-top:1px solid var(--glass-border);background:var(--glass-bg);backdrop-filter:blur(10px);">
      <span>© {new Date().getFullYear()} {profile.name}</span>
    </footer>
    <script is:inline>
      (function () {
        var i18n = {
          en: {
            'nav.works': 'Works',
            'nav.blog': 'Blog',
            'nav.about': 'About',
            'hero.tag': 'Creative Developer',
            'hero.name': 'rapeseed_flower233',
            'hero.desc': 'Creating across pixels, sound, and code.',
            'works.title': 'Selected Works',
            'works.all': 'All',
            'works.painting': 'Painting',
            'works.music': 'Music',
            'works.design': 'Design',
            'works.code': 'Code',
            'blog.title': 'Articles',
            'blog.search': 'Search articles...',
            'blog.all': 'All',
            'blog.read': 'Read',
            'about.title': 'About Me',
            'about.p1': 'A freelancer exploring full-stack development, pixel art enthusiast, practicing experimental music production. I build small games and utility tools, and occasionally have bold ideas and try to make them happen.',
            'about.p2': '',
            'about.currently': 'Working on indie dev projects at home, taking freelance gigs, and looking for suitable job opportunities.',
            'about.github': 'GitHub',
            'about.email': 'Email',
            'about.bilibili': 'Bilibili',
            'about.currently_heading': 'Currently',
            'nav.lang': 'EN',
            'footer.rights': 'All rights reserved',
            'detail.back': 'Back',
          },
          zh: {
            'nav.works': '作品',
            'nav.blog': '博客',
            'nav.about': '关于',
            'hero.tag': '创意开发者',
            'hero.name': 'rapeseed_flower233',
            'hero.desc': '在像素、声音与代码之间创作。',
            'works.title': '精选作品',
            'works.all': '全部',
            'works.painting': '绘画',
            'works.music': '音乐',
            'works.design': '设计',
            'works.code': '代码',
            'blog.title': '文章',
            'blog.search': '搜索文章...',
            'blog.all': '全部',
            'blog.read': '阅读',
            'about.title': '关于我',
            'about.p1': '一个尝试做全栈开发的自由人，像素画爱好者，正在练习实验编曲，会搓些小游戏和小工具应用，偶尔会有些大胆的想法并尝试着做一做。',
            'about.p2': '',
            'about.currently': '在家做独立开发项目，正在尝试接单，和看看有没有适合的工作。',
            'about.github': 'GitHub',
            'about.email': '邮箱',
            'about.bilibili': '哔哩哔哩',
            'about.currently_heading': '当前动态',
            'nav.lang': '中',
            'footer.rights': '版权所有',
            'detail.back': '返回',
          }
        };

        function getLang() { return localStorage.getItem('lang') || 'en'; }

        function setLang(lang) {
          localStorage.setItem('lang', lang);
          document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.getAttribute('data-i18n');
            if (key && i18n[lang] && i18n[lang][key] !== undefined) {
              el.textContent = i18n[lang][key];
            }
          });
          document.querySelectorAll('[data-i18n-title]').forEach(function (el) {
            el.textContent = el.getAttribute('data-' + lang) || el.textContent;
          });
          document.querySelectorAll('[data-i18n-desc]').forEach(function (el) {
            el.textContent = el.getAttribute('data-' + lang) || el.textContent;
          });
          document.querySelectorAll('[data-i18n-stat]').forEach(function (el) {
            el.textContent = el.getAttribute('data-' + lang) || el.textContent;
          });
        }

        // Prevent theme flash during client-side navigation by setting the correct
        // data-theme on the incoming document before it is swapped in
        document.addEventListener('astro:before-swap', function (e) {
          var currentTheme = document.documentElement.getAttribute('data-theme');
          var newDoc = e.detail && e.detail.newDocument;
          if (newDoc && currentTheme) {
            newDoc.documentElement.setAttribute('data-theme', currentTheme);
          }
        });

        function initSite() {
          document.body.style.visibility = 'visible';
          // Restore theme from localStorage
          var savedTheme = localStorage.getItem('theme');
          if (savedTheme === 'dark' || savedTheme === 'light') {
            document.documentElement.setAttribute('data-theme', savedTheme);
          }
          setLang(getLang());
          // Theme toggle
          document.querySelectorAll('.theme-toggle').forEach(function (btn) {
            if (btn._bound) return;
            btn._bound = true;
            function sync() {
              var dark = document.documentElement.getAttribute('data-theme') === 'dark';
              var sun = btn.querySelector('.icon-sun');
              var moon = btn.querySelector('.icon-moon');
              if (sun) sun.style.display = dark ? 'none' : '';
              if (moon) moon.style.display = dark ? '' : 'none';
            }
            sync();
            btn.addEventListener('click', function () {
              var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
              document.documentElement.setAttribute('data-theme', next);
              localStorage.setItem('theme', next);
              sync();
            });
          });

          // Language toggle
          document.querySelectorAll('.lang-toggle').forEach(function (btn) {
            if (btn._bound) return;
            btn._bound = true;
            btn.addEventListener('click', function () {
              setLang(getLang() === 'en' ? 'zh' : 'en');
            });
          });

          // Tab switching
          document.querySelectorAll('[data-tab]').forEach(function (btn) {
            if (btn._bound) return;
            btn._bound = true;
            btn.addEventListener('click', function () {
              var target = btn.getAttribute('data-tab');
              if (!target) return;
              document.querySelectorAll('.tab-panel').forEach(function (p) { p.classList.remove('active'); });
              document.querySelectorAll('[data-tab]').forEach(function (b) { b.classList.remove('tab-active'); });
              var panel = document.getElementById('tab-' + target);
              if (panel) panel.classList.add('active');
              btn.classList.add('tab-active');
              history.replaceState(null, '', '#' + target);
            });
          });

          // Activate tab from URL hash
          var hash = location.hash.slice(1);
          if (['works', 'blog', 'about'].indexOf(hash) !== -1) {
            var btn = document.querySelector('[data-tab="' + hash + '"]');
            if (btn) btn.click();
          } else {
            var defaultBtn = document.querySelector('[data-tab="works"]');
            if (defaultBtn) defaultBtn.click();
          }

          // Fade in observer
          var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) e.target.classList.add('visible');
            });
          }, { threshold: 0.05 });
          document.querySelectorAll('.fade-in').forEach(function (el) { obs.observe(el); });

          // Cursor glow
          var glow = document.getElementById('cursor-glow');
          if (glow && !glow._bound) {
            glow._bound = true;
            var rafId = null;
            var mx = 0, my = 0;
            document.addEventListener('mousemove', function(e) {
              mx = e.clientX; my = e.clientY;
              if (!rafId) {
                rafId = requestAnimationFrame(function() {
                  glow.style.left = mx + 'px';
                  glow.style.top = my + 'px';
                  glow.classList.add('active');
                  rafId = null;
                });
              }
            });
            document.addEventListener('mouseleave', function() {
              glow.classList.remove('active');
            });
          }
        }

        document.addEventListener('DOMContentLoaded', initSite);
        document.addEventListener('astro:page-load', initSite);
      })();
    </script>
  </body>
</html>
