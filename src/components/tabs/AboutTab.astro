---
import { profile } from '../../data/profile';
import { media } from '../../data/media';
---

<div class="container" style="padding-top:24px; padding-bottom:24px;">
  <div class="about-grid">
    <div class="fade-in">
      <div class="about-avatar">
        <img src={media(profile.avatar)} alt={profile.name} class="about-avatar-img" />
      </div>
      <div style="margin-top:14px; text-align:center;">
        <div class="gradient-text" style="font-size:16px; font-weight:700; letter-spacing:-0.02em;">{profile.name}</div>
        <div style="font-size:12px; color:var(--text-3); margin-top:3px;" data-i18n="hero.tag">{profile.title}</div>
      </div>
    </div>
    <div class="about-text fade-in" style="animation-delay:80ms;">
      <h2 data-i18n="about.title">About Me</h2>
      <p data-i18n="about.p1">{profile.bio.en[0]}</p>
      <p data-i18n="about.p2">{profile.bio.en[1]}</p>

      <div class="flex gap-2" style="margin-top:20px;">
        {profile.links.map((link) => (
          <a
            href={link.url}
            target={link.icon === 'email' ? undefined : '_blank'}
            rel={link.icon === 'email' ? undefined : 'noopener noreferrer'}
            class="btn"
          >
            {link.icon === 'github' && (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            )}
            {link.icon === 'bilibili' && (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.267.573-.4.92-.4.347 0 .653.133.92.4L9.387 4.44c.071.071.134.142.187.213h4.852a.836.836 0 0 1 .16-.213l2.56-2.547c.267-.267.573-.4.92-.4.347 0 .662.133.947.4.267.249.4.551.4.907 0 .355-.133.657-.4.906z"/></svg>
            )}
            {link.icon === 'email' && (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-10 7L2 7"/></svg>
            )}
            <span>{link.label}</span>
          </a>
        ))}
      </div>

      <div class="stat-grid">
        {profile.stats.map((s) => (
          <div class="stat-item">
            <div class="stat-num" data-target={s.num} data-suffix={s.suffix}>{s.num}{s.suffix}</div>
            <div class="stat-label" data-i18n-stat data-en={s.label.en} data-zh={s.label.zh}>{s.label.en}</div>
          </div>
        ))}
      </div>

      <div class="fade-in" style="animation-delay:200ms; margin-top:24px; padding:16px; border-radius:10px; background:var(--glass-bg); backdrop-filter:blur(10px); border:1px solid var(--glass-border);">
        <div style="font-size:11px; font-weight:600; color:var(--text-3); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:8px;" data-i18n="about.currently_heading">Currently</div>
        <div style="font-size:13px; color:var(--text-2); line-height:1.6;" data-i18n="about.currently">
          {profile.currently.en}
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function initAbout() {
    document.querySelectorAll('.stat-num').forEach(function(el) {
      if (el._done) return;
      el._done = true;
      var target = parseInt(el.getAttribute('data-target') || '0');
      var suffix = el.getAttribute('data-suffix') || '';
      var current = 0;
      var step = Math.max(1, Math.floor(target / 20));
      var interval = setInterval(function() {
        current += step;
        if (current >= target) { current = target; clearInterval(interval); }
        el.textContent = current + suffix;
      }, 30);
    });
  }
  document.addEventListener('DOMContentLoaded', initAbout);
  document.addEventListener('astro:page-load', initAbout);
</script>
