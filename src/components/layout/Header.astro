---
import { profile } from '../../data/profile';
import { media } from '../../data/media';

const tabs = [
  { key: 'works', label: 'nav.works', num: '01' },
  { key: 'blog', label: 'nav.blog', num: '02' },
  { key: 'about', label: 'nav.about', num: '03' },
];

const segments = Astro.url.pathname.split('/').filter(Boolean);
const isDetail = segments.length > 1;
---

{isDetail ? (
  <header class="detail-header">
      <a href="/" class="avatar" aria-label="Home">
        <img src={media(profile.avatar)} alt={profile.name} class="avatar-img" />
      </a>
      <div style="flex:1"></div>
    <button class="theme-toggle" style="padding:6px;border-radius:8px;background:none;border:1px solid var(--border);cursor:pointer;color:var(--text-2);display:flex;align-items:center;justify-content:center;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--color-accent)';this.style.color='var(--color-accent)';this.style.boxShadow='0 0 12px var(--glow)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-2)';this.style.boxShadow='none'">
      <span class="icon-sun">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
      </span>
      <span class="icon-moon" style="display:none;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </span>
    </button>
  </header>
) : (
  <header id="site-header">
    <div class="container flex items-center justify-between h-full">
      <a href="/" class="avatar" aria-label="Home">
        <img src={media(profile.avatar)} alt={profile.name} class="avatar-img" />
      </a>

      <nav class="flex items-center h-full">
        {tabs.map((t) => (
          <button class="tab-btn" data-tab={t.key}>
            <span class="tab-num">{t.num}</span>
            <span data-i18n={t.label}>{t.key === 'works' ? 'Works' : t.key === 'blog' ? 'Blog' : 'About'}</span>
          </button>
        ))}

        <div class="flex items-center h-full" style="border-left:1px solid var(--border); margin-left:2px;">
          <button class="lang-toggle" style="padding:0 12px;height:100%;background:none;border:none;cursor:pointer;font-size:11px;font-weight:600;color:var(--text-3);font-family:var(--font-sans);transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-3)'">
            <span data-i18n="nav.lang">EN</span>
          </button>
        </div>

        <div class="flex items-center h-full" style="border-left:1px solid var(--border);">
          <button class="theme-toggle" style="padding:0 12px;height:100%;background:none;border:none;cursor:pointer;color:var(--text-3);display:flex;align-items:center;transition:color 0.15s;" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-3)'">
            <span class="icon-sun">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            </span>
            <span class="icon-moon" style="display:none;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </span>
          </button>
        </div>
      </nav>
    </div>
  </header>
)}
